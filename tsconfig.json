{
    "include": ["src/**/*.ts"],
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "skipLibCheck": true,
        "types": ["node", "pg"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
}